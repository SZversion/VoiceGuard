# 실제 값은 .env 또는 Railway 환경변수에만 저장하세요.
# 이 파일에는 키 이름과 로컬 개발용 기본값만 기록합니다.

NUXT_ORIGIN=http://localhost:3000
IP_HASH_SECRET=replace-with-a-random-secret
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

ANALYSIS_TIMEOUT_SECONDS=300
STT_MAX_NEW_TOKENS=128
STT_AUDIO_CHUNK_SECONDS=30
STT_RUNTIME=faster-whisper
STT_CT2_MODEL_PATH=models/whisper-lora/ct2-int8

# 비공개 Hugging Face 모델 접근용 토큰 (실제 값은 .env에만 입력)
HF_TOKEN=
